# Desenvolvimento local com Docker
DATABASE_URL="postgresql://ksales_app:ksales_dev@localhost:5432/ksales?schema=public"

# Fuso da operação, usado para fechar o dia nas métricas
OPERATION_TIME_ZONE="America/Sao_Paulo"

# Pasta da trilha de auditoria (um arquivo por dia). O padrão é ./audit-logs
# na raiz do projeto. Em produção aponte para fora da pasta de deploy, senão
# cada atualização de código apaga o histórico.
AUDIT_LOG_DIR=""

# Senha do administrador criado pelo seed. Se ficar vazio, o seed gera uma
# senha aleatória e a imprime uma única vez no terminal.
SEED_ADMIN_EMAIL="admin@kalebhawi.com.br"
SEED_ADMIN_PASSWORD=""

# Produção: substitua pelos valores configurados na VPS
# DATABASE_URL="postgresql://ksales_app:SENHA_FORTE@127.0.0.1:5432/ksales?schema=public"
