# Modelo do /var/www/ksales/.env na VPS.
#
# Este arquivo é só o modelo e vai para o Git. O .env real NUNCA vai:
#   chmod 600 /var/www/ksales/.env
#
# Regra da operação: a senha do banco não pode ser a mesma senha de SSH da VPS.
# Gere uma independente, por exemplo:
#   openssl rand -base64 24

DATABASE_URL="postgresql://ksales_app:TROQUE_POR_SENHA_FORTE@127.0.0.1:5432/ksales?schema=public"

# Fuso da loja. As métricas fecham o dia por ele, não pelo relógio da VPS
# (que roda em UTC e viraria o dia às 21h de Brasília).
OPERATION_TIME_ZONE="America/Sao_Paulo"

# Trilha de auditoria: FORA da pasta de deploy, senão cada atualização de
# código apaga o histórico. Crie antes com:
#   mkdir -p /var/lib/ksales/audit-logs && chown ksales: /var/lib/ksales/audit-logs
AUDIT_LOG_DIR="/var/lib/ksales/audit-logs"

# Usado apenas na primeira execução de `npm run db:seed`, para criar o
# administrador. Depois disso pode ficar vazio: rodar o seed de novo não
# sobrescreve a senha de um administrador que já existe.
SEED_ADMIN_EMAIL="admin@kalebhawi.com.br"
SEED_ADMIN_PASSWORD=""

NODE_ENV="production"
